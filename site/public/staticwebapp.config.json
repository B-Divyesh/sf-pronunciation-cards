{
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
  },
  "mimeTypes": {
    ".avif": "image/avif",
    ".zip": "application/zip"
  },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=3600, must-revalidate" } },
    { "route": "/downloads/*", "headers": { "Cache-Control": "no-cache, must-revalidate" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache, must-revalidate" } }
  ]
}
