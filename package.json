{
  "name": "pronunciation-cards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "assets": "node scripts/build-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "build:extension": "wxt build",
    "build:site": "vite build --config vite.site.config.ts",
    "package": "node scripts/package-extension.mjs",
    "build": "npm run clean && npm run assets && npm run build:extension && npm run build:site && npm run package",
    "preview:site": "vite preview --config vite.site.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "fflate": "0.8.2",
    "playwright-core": "1.58.2",
    "sharp": "0.34.3",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4",
    "wxt": "0.20.7"
  }
}
